{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": { "@/*": ["./*"] },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["*.ts", "*.tsx", "vim", "lib"]
}
